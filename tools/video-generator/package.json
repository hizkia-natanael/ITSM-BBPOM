{
  "name": "elite-video-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Automated video tutorial generator for ELITE BBPOM using Playwright, Edge-TTS, and Remotion",
  "type": "module",
  "scripts": {
    "build-all": "node scripts/build-tutorial.js",
    "capture": "node scripts/capture.js",
    "tts": "node scripts/generate-tts.js",
    "render": "remotion render src/index.ts TutorialScenarioA out/tutorial-pengajuan-tiket.mp4",
    "preview": "remotion preview src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.282",
    "@remotion/media-utils": "^4.0.282",
    "node-edge-tts": "^1.2.12",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.282"
  }
}
